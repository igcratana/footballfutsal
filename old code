            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            user-select: none;
            cursor: pointer;
            text-align: center;
        }
        #connectionStatus {
            font-size: 12px;
            color: #ffeb3b;
            margin-top: 5px;
        }
    </style>
</head>
<body>

    <!-- ផ្ទាំងជ្រើសរើសរបៀបលេង (Menu Screen) -->
    <div id="mainMenu" class="menu-box">
        <h2>⚽ 3D Soccer Online P2P</h2>
        <button onclick="showSoloSetup()" class="btn-secondary">លេងទោល (Solo / AI)</button>
        <button onclick="showMultiMenu()">លេងជាមិត្តភ័ក្តិ (Online Multiplayer)</button>
    </div>

    <!-- ផ្ទាំង Online Setup (Create / Join Room) -->
    <div id="multiMenu" class="menu-box" style="display:none;">
        <h2>🌐 Online Multiplayer</h2>
        <input type="text" id="roomNameInput" placeholder="បញ្ចូលឈ្មោះ Room (ឧ. match123)">
        <button onclick="createRoom()">បង្កើត Room ថ្មី (Host)</button>
        <button onclick="joinRoom()" class="btn-secondary">ចូល Room ដែលមានរួចហើយ (Join)</button>
        <button onclick="backToMain()" style="background:#555;">ត្រឡប់ក្រោយ</button>
        <div id="connectionStatus"></div>
    </div>

    <!-- ផ្ទាំងជ្រើសរើស ក្រុម និង តួនាទី -->
    <div id="setupScreen" class="menu-box" style="display:none;">
        <h2 id="setupTitle">ជ្រើសរើសក្រុម និង តួនាទី</h2>
        
        <label style="font-size: 13px; color:#aaa; display:block; text-align:left;">ជ្រើសរើសក្រុម:</label>
        <select id="teamSelect" onchange="updateRoleOptions()">
            <option value="blue">ក្រុមខៀវ (Blue Team)</option>
            <option value="red">ក្រុមក្រហម (Red Team)</option>
        </select>

        <label style="font-size: 13px; color:#aaa; display:block; text-align:left; margin-top:5px;">ជ្រើសរើសតួនាទី (Role):</label>
        <select id="roleSelect">
            <option value="1">លេខ 1 - Goalie (អ្នកចាំទី)</option>
            <option value="2">លេខ 2 - Defender (ខ្សែការពារឆ្វេង)</option>
            <option value="3">លេខ 3 - Defender (ខ្សែការពារស្តាំ)</option>
            <option value="4">លេខ 4 - Midfielder (ខ្សែបម្រើឆ្វេង)</option>
            <option value="5">លេខ 5 - Midfielder (ខ្សែបម្រើស្តាំ)</option>
            <option value="6" selected>លេខ 6 - Forward (ខ្សែប្រយុទ្ធ)</option>
        </select>

        <button onclick="startActiveGame()">ចូលលេងហ្គេម (Play)</button>
    </div>

    <h2 id="gameTitle" style="display:none;">Soccer Championship</h2>
    <div id="scoreboard" style="display:none;">ខៀវ: <span id="blueScore">0</span> - <span id="redScore">0</span> :ក្រហម</div>
    
    <canvas id="gameCanvas" width="400" height="600"></canvas>
    
    <div id="gameInstructions" class="instructions">
        អូស Joystick ខាងឆ្វេងដើម្បីដើរ | ចុចប៊ូតុងខាងស្ដាំដើម្បីសុត ឬសុំបាល់
    </div>

    <!-- ប៊ូតុងបញ្ជាលើទូរស័ព្ទ (Joystick & Action Button) -->
    <div id="mobileControls">
        <div id="joystickBase">
            <div id="joystickStick"></div>
        </div>
        <div id="actionBtn">សុត /<br>សុំបាល់</div>
    </div>

<script>
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

let blueScore = 0;
let redScore = 0;
let gameStarted = false;

// ការកំណត់ Online & PeerJS
let peer = null;
let conn = null;
let isHost = false;
let myTeam = 'blue';
let myPlayerNumber = 6;
let takenRoles = { blue: [], red: [] };

const field = {
    width: 400,
    height: 600,
    goalWidth: 120
};

let ball = {
    x: field.width / 2,
    y: field.height / 2,
    radius: 8,
    vx: 0,
    vy: 0,
    friction: 0.985,
    bounce: -0.85 // កម្លាំងលោតបង្វិលត្រឡប់មកវិញ (Restitution)
};

let powerCharging = false;
let powerLevel = 0;
let currentCarrier = null;
let releaseCooldown = 0;

let joystickData = { active: false, dirX: 0, dirY: 0, touchId: null };
let keys = {};

class Player {
    constructor(x, y, team, number, role) {
        this.x = x;
        this.y = y;
        this.startX = x;
        this.startY = y;
        this.radius = 14;
        this.team = team; 
        this.number = number; 
        this.role = role; 
        this.vx = 0;
        this.vy = 0;
        this.baseSpeed = 1.0; 
        this.lastDirX = 0;
        this.lastDirY = (team === 'blue') ? -1 : 1;
    }

    get isControlled() {
        return this.team === myTeam && this.number === myPlayerNumber;
    }

    draw() {
        ctx.beginPath();
        ctx.ellipse(this.x, this.y + 6, this.radius * 0.8, this.radius * 0.4, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
        ctx.fill();
        ctx.closePath();

        let grad = ctx.createRadialGradient(this.x - 4, this.y - 4, 2, this.x, this.y, this.radius);
        if (this.team === 'blue') {
            grad.addColorStop(0, '#64b5f6');
            grad.addColorStop(1, '#1565c0');
        } else {
            grad.addColorStop(0, '#e57373');
            grad.addColorStop(1, '#c62828');
        }

        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#fff';
        ctx.stroke();
        ctx.closePath();

        ctx.fillStyle = '#fff';
        ctx.font = 'bold 11px Arial';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(this.number, this.x, this.y);

        if (this.isControlled) {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.radius + 5, 0, Math.PI * 2);
            ctx.strokeStyle = '#ffeb3b';
            ctx.lineWidth = 2.5;
            ctx.stroke();
            ctx.closePath();

            if (powerCharging && currentCarrier === this) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
                ctx.fillRect(this.x - 22, this.y - 32, 44, 6);
                ctx.fillStyle = powerLevel > 70 ? '#f44336' : '#4CAF50';
                ctx.fillRect(this.x - 22, this.y - 32, (powerLevel / 100) * 44, 6);
            }
        }
    }

    update() {
        if (this.isControlled) {
            let currentSpeed = (currentCarrier === this) ? 1.0 : this.baseSpeed;
            let moveX = 0, moveY = 0;

            if (keys['w'] || keys['arrowup']) moveY = -1;
            if (keys['s'] || keys['arrowdown']) moveY = 1;
            if (keys['a'] || keys['arrowleft']) moveX = -1;
            if (keys['d'] || keys['arrowright']) moveX = 1;

            if (joystickData.active) {
                moveX = joystickData.dirX;
                moveY = joystickData.dirY;
            }

            if (moveX !== 0 || moveY !== 0) {
                this.vx = moveX * currentSpeed;
                this.vy = moveY * currentSpeed;
                this.lastDirX = moveX;
                this.lastDirY = moveY;
            } else {
                this.vx = 0;
                this.vy = 0;
            }

            this.x += this.vx;
            this.y += this.vy;

            if (this.x < this.radius) this.x = this.radius;
            if (this.x > field.width - this.radius) this.x = field.width - this.radius;
            if (this.y < this.radius) this.y = this.radius;
            if (this.y > field.height - this.radius) this.y = field.height - this.radius;
        } 
        else {
            let targetX = this.startX;
            let targetY = this.startY;

            if (this.role === 'Goalie') {
                targetX = ball.x; 
                if (targetX < field.width / 2 - field.goalWidth / 2 + 10) targetX = field.width / 2 - field.goalWidth / 2 + 10;
                if (targetX > field.width / 2 + field.goalWidth / 2 - 10) targetX = field.width / 2 + field.goalWidth / 2 - 10;
                targetY = this.startY;
            } else {
                if (currentCarrier) {
                    if (this.team !== currentCarrier.team) {
                        targetX = currentCarrier.x;
                        targetY = currentCarrier.y;
                    } else {
                        targetX = this.startX + (ball.x - field.width / 2) * 0.1;
                        targetY = this.startY;
                    }
                } else {
                    targetX = ball.x;
                    targetY = ball.y;
                }
            }

            let dx = targetX - this.x;
            let dy = targetY - this.y;
            let dist = Math.sqrt(dx * dx + dy * dy);

            if (dist > 1.5) {
                let moveSpeed = (this.team === 'red') ? this.baseSpeed * 0.55 : this.baseSpeed * 0.45;
                if (this.role === 'Goalie') moveSpeed = this.baseSpeed * 0.7;
                this.x += (dx / dist) * moveSpeed;
                this.y += (dy / dist) * moveSpeed;
            }
        }
    }
}

let players = [
    new Player(field.width / 2, 40, 'red', 1, 'Goalie'),
    new Player(130, 140, 'red', 2, 'Defender'),
    new Player(270, 140, 'red', 3, 'Defender'),
    new Player(130, 240, 'red', 4, 'Midfielder'),
    new Player(270, 240, 'red', 5, 'Midfielder'),
    new Player(field.width / 2, 190, 'red', 6, 'Forward'),

    new Player(field.width / 2, field.height - 40, 'blue', 1, 'Goalie'),
    new Player(130, field.height - 140, 'blue', 2, 'Defender'),
    new Player(270, field.height - 140, 'blue', 3, 'Defender'),
    new Player(130, field.height - 240, 'blue', 4, 'Midfielder'),
    new Player(270, field.height - 240, 'blue', 5, 'Midfielder'),
    new Player(field.width / 2, field.height - 190, 'blue', 6, 'Forward')
];

function showSoloSetup() {
    document.getElementById("mainMenu").style.display = "none";
    document.getElementById("setupScreen").style.display = "block";
    isHost = true;
    updateRoleOptions();
}

function showMultiMenu() {
    document.getElementById("mainMenu").style.display = "none";
    document.getElementById("multiMenu").style.display = "block";
}

function backToMain() {
    document.getElementById("multiMenu").style.display = "none";
    document.getElementById("mainMenu").style.display = "block";
}

function createRoom() {
    let roomName = document.getElementById("roomNameInput").value.trim();
    if (!roomName) {
        alert("សូមបញ្ចូលឈ្មោះ Room ជាមុនសិន!");
        return;
    }
    document.getElementById("connectionStatus").innerText = "កំពុងបង្កើត Room...";
    peer = new Peer("soccer_room_" + roomName);

    peer.on('open', (id) => {
        isHost = true;
        document.getElementById("multiMenu").style.display = "none";
        document.getElementById("setupScreen").style.display = "block";
        updateRoleOptions();
    });

    peer.on('connection', (incomingConn) => {
        conn = incomingConn;
        setupConnection();
    });

    peer.on('error', (err) => {
        alert("ឈ្មោះ Room នេះមានគេប្រើរួចហើយ ឬមានបញ្ហា Network!");
        document.getElementById("connectionStatus").innerText = "";
    });
}

function joinRoom() {
    let roomName = document.getElementById("roomNameInput").value.trim();
    if (!roomName) {
        alert("សូមបញ្ចូលឈ្មោះ Room ដែលត្រូវចូល!");
        return;
    }
    document.getElementById("connectionStatus").innerText = "កំពុងតភ្ជាប់ទៅ Room...";
    peer = new Peer();

    peer.on('open', (id) => {
        isHost = false;
        conn = peer.connect("soccer_room_" + roomName);
        setupConnection();
    });

    peer.on('error', (err) => {
        alert("រកមិនឃើញ Room នេះទេ សូមពិនិត្យឈ្មោះឡើងវិញ!");
        document.getElementById("connectionStatus").innerText = "";
    });
}

function setupConnection() {
    conn.on('open', () => {
        document.getElementById("multiMenu").style.display = "none";
        document.getElementById("setupScreen").style.display = "block";
        updateRoleOptions();
    });

    conn.on('data', (data) => {
        if (data.type === 'SELECT_ROLE') {
            takenRoles[data.team] = takenRoles[data.team] || [];
            if (!takenRoles[data.team].includes(data.number)) {
                takenRoles[data.team].push(data.number);
            }
            updateRoleOptions();
        } else if (data.type === 'GAME_STATE' && !isHost) {
            ball.x = data.ball.x;
            ball.y = data.ball.y;
            ball.vx = data.ball.vx;
            ball.vy = data.ball.vy;
            blueScore = data.blueScore;
            redScore = data.redScore;
            document.getElementById("blueScore").innerText = blueScore;
            document.getElementById("redScore").innerText = redScore;
            
            for(let i=0; i<players.length; i++) {
                players[i].x = data.players[i].x;
                players[i].y = data.players[i].y;
            }
        }
    });
}

function updateRoleOptions() {
    let team = document.getElementById("teamSelect").value;
    let roleSelect = document.getElementById("roleSelect");
    
    for (let option of roleSelect.options) {
        let num = parseInt(option.value);
        if (takenRoles[team] && takenRoles[team].includes(num)) {
            option.disabled = true;
            option.text += " (មានគេយកហើយ)";
        } else {
            option.disabled = false;
            option.text = option.text.replace(" (មានគេយកហើយ)", "");
        }
    }
}

function startActiveGame() {
    myTeam = document.getElementById("teamSelect").value;
    myPlayerNumber = parseInt(document.getElementById("roleSelect").value);

    if (conn && conn.open) {
        conn.send({ type: 'SELECT_ROLE', team: myTeam, number: myPlayerNumber });
    }

    document.getElementById("setupScreen").style.display = "none";
    document.getElementById("gameTitle").style.display = "block";
    document.getElementById("scoreboard").style.display = "block";
    document.getElementById("gameCanvas").style.display = "block";
    document.getElementById("gameInstructions").style.display = "block";
    document.getElementById("mobileControls").style.display = "flex";

    gameStarted = true;
}

// Joystick Events
const joystickBase = document.getElementById('joystickBase');
const joystickStick = document.getElementById('joystickStick');

function handleJoystickMove(clientX, clientY) {
    let rect = joystickBase.getBoundingClientRect();
    let centerX = rect.left + rect.width / 2;
    let centerY = rect.top + rect.height / 2;
    
    let dx = clientX - centerX;
    let dy = clientY - centerY;
    let distance = Math.hypot(dx, dy);
    let maxRadius = 40;

    if (distance > maxRadius) {
        dx = (dx / distance) * maxRadius;
        dy = (dy / distance) * maxRadius;
    }

    joystickStick.style.transform = `translate(${dx}px, ${dy}px)`;
    joystickData.active = true;
    joystickData.dirX = dx / maxRadius;
    joystickData.dirY = dy / maxRadius;
}

joystickBase.addEventListener('touchstart', (e) => {
    let touch = e.targetTouches[0];
    joystickData.touchId = touch.identifier;
    handleJoystickMove(touch.clientX, touch.clientY);
    e.preventDefault();
}, { passive: false });

window.addEventListener('touchmove', (e) => {
    if (!joystickData.active) return;
    for (let i = 0; i < e.targetTouches.length; i++) {
        let touch = e.targetTouches[i];
        if (touch.identifier === joystickData.touchId) {
            handleJoystickMove(touch.clientX, touch.clientY);
            break;
        }
    }
    e.preventDefault();
}, { passive: false });

window.addEventListener('touchend', (e) => {
    if (!joystickData.active) return;
    let released = true;
    for (let i = 0; i < e.targetTouches.length; i++) {
        if (e.targetTouches[i].identifier === joystickData.touchId) {
            released = false;
            break;
        }
    }
    if (released) resetJoystick();
});

joystickBase.addEventListener('mousedown', (e) => {
    joystickData.active = true;
    handleJoystickMove(e.clientX, e.clientY);
});

window.addEventListener('mousemove', (e) => {
    if (joystickData.active && e.buttons === 1) {
        handleJoystickMove(e.clientX, e.clientY);
    }
});

window.addEventListener('mouseup', () => {
    if (joystickData.active) resetJoystick();
});

function resetJoystick() {
    joystickData.active = false;
    joystickData.dirX = 0;
    joystickData.dirY = 0;
    joystickData.touchId = null;
    joystickStick.style.transform = `translate(0px, 0px)`;
}

// Action Button (Shoot / Pass)
let actionEl = document.getElementById('actionBtn');
actionEl.addEventListener('touchstart', (e) => { if(gameStarted) triggerActionStart(); e.preventDefault(); });
actionEl.addEventListener('touchend', (e) => { if(gameStarted) triggerActionEnd(); e.preventDefault(); });
actionEl.addEventListener('mousedown', () => { if(gameStarted) triggerActionStart(); });
actionEl.addEventListener('mouseup', () => { if(gameStarted) triggerActionEnd(); });

function triggerActionStart() {
    players.forEach(player => {
        if (player.isControlled) {
            if (currentCarrier === player) powerCharging = true;
            else requestPassToPlayer(player);
        }
    });
}

function triggerActionEnd() {
    if (powerCharging) {
        players.forEach(player => {
            if (player.isControlled && currentCarrier === player) {
                let finalPower = Math.max(4.0, (powerLevel / 100) * 12);
                let dirX = player.lastDirX !== 0 ? player.lastDirX : 0;
                let dirY = player.lastDirY !== 0 ? player.lastDirY : -1;

                currentCarrier = null;
                releaseCooldown = 25; 
                ball.vx = dirX * finalPower;
                ball.vy = dirY * finalPower;
            }
        });
        powerCharging = false;
        powerLevel = 0;
    }
}

function requestPassToPlayer(receiver) {
    if (currentCarrier && currentCarrier.team === receiver.team && currentCarrier !== receiver) {
        let passer = currentCarrier;
        currentCarrier = null;
        releaseCooldown = 25;
        let angle = Math.atan2(receiver.y - passer.y, receiver.x - passer.x);
        ball.vx = Math.cos(angle) * 6;
        ball.vy = Math.sin(angle) * 6;
    }
}

function drawField3D() {
    ctx.clearRect(0, 0, field.width, field.height);
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
    ctx.lineWidth = 3;
    
    ctx.beginPath();
    ctx.moveTo(0, field.height / 2);
    ctx.lineTo(field.width, field.height / 2);
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(field.width / 2, field.height / 2, 55, 0, Math.PI * 2);
    ctx.stroke();

    let goalLeft = (field.width - field.goalWidth) / 2;
    let goalRight = goalLeft + field.goalWidth;

    ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
    ctx.fillRect(goalLeft, -10, field.goalWidth, 35);
    ctx.strokeStyle = '#fff';
    ctx.strokeRect(goalLeft, 0, field.goalWidth, 25);

    ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
    ctx.fillRect(goalLeft, field.height - 25, field.goalWidth, 35);
    ctx.strokeRect(goalLeft, field.height - 25, field.goalWidth, 25);
}

let enemyActionTimer = 0;

function updateGame() {
    if (!gameStarted) return;

    if (releaseCooldown > 0) releaseCooldown--;

    if (powerCharging) {
        powerLevel += 4;
        if (powerLevel > 100) powerLevel = 100;
    }

    if (isHost) {
        if (currentCarrier) {
            ball.x = currentCarrier.x + currentCarrier.lastDirX * 16;
            ball.y = currentCarrier.y + currentCarrier.lastDirY * 16; 

            if (currentCarrier.team === 'red') {
                enemyActionTimer++;
                if (enemyActionTimer > 90) {
                    enemyActionTimer = 0;
                    currentCarrier = null;
                    releaseCooldown = 25;
                    ball.vx = (Math.random() - 0.5) * 4;
                    ball.vy = 5; 
                }
            }
        } else {
            ball.x += ball.vx;
            ball.y += ball.vy;
            ball.vx *= ball.friction;
            ball.vy *= ball.friction;

            if (releaseCooldown === 0) {
                players.forEach(player => {
                    let dist = Math.hypot(ball.x - player.x, ball.y - player.y);
                    if (dist < player.radius + ball.radius + 4) {
                        currentCarrier = player;
                        if (player.team === 'red') enemyActionTimer = 0;
                    }
                });
            }
        }

        // --- កែសម្រួល៖ បាល់ប៉ះគែម ឬក្រៅទីលាន លោតត្រឡប់ចូលក្នុងវិញ ---
        let goalLeft = (field.width - field.goalWidth) / 2;
        let goalRight = goalLeft + field.goalWidth;

        // ប៉ះគែមឆ្វេង
        if (ball.x - ball.radius < 0) {
            ball.x = ball.radius;
            ball.vx *= ball.bounce;
        }
        // ប៉ះគែមស្ដាំ
        if (ball.x + ball.radius > field.width) {
            ball.x = field.width - ball.radius;
            ball.vx *= ball.bounce;
        }

        // ប៉ះគែមខាងលើ (Top Boundary / Goal Check)
        if (ball.y - ball.radius < 0) {
            if (ball.x > goalLeft && ball.x < goalRight) {
                blueScore++;
                document.getElementById("blueScore").innerText = blueScore;
                resetBall();
            } else {
                ball.y = ball.radius;
                ball.vy *= ball.bounce; // លោតត្រឡប់ចូលក្នុងវិញ
            }
        }

        // ប៉ះគែមខាងក្រោម (Bottom Boundary / Goal Check)
        if (ball.y + ball.radius > field.height) {
            if (ball.x > goalLeft && ball.x < goalRight) {
                redScore++;
                document.getElementById("redScore").innerText = redScore;
                resetBall();
            } else {
                ball.y = field.height - ball.radius;
                ball.vy *= ball.bounce; // លោតត្រឡប់ចូលក្នុងវិញ
            }
        }

        if (conn && conn.open) {
            conn.send({
                type: 'GAME_STATE',
                ball: { x: ball.x, y: ball.y, vx: ball.vx, vy: ball.vy },
                blueScore: blueScore,
                redScore: redScore,
                players: players.map(p => ({ x: p.x, y: p.y }))
            });
        }
    }

    players.forEach(player => {
        player.update();
        if (!isHost && releaseCooldown === 0 && !currentCarrier) {
            let dist = Math.hypot(ball.x - player.x, ball.y - player.y);
            if (dist < player.radius + ball.radius + 2) {
                currentCarrier = player;
            }
        }
    });
}

function resetBall() {
    ball.x = field.width / 2;
    ball.y = field.height / 2;
    ball.vx = 0;
    ball.vy = 0;
    currentCarrier = null;
    powerCharging = false;
    powerLevel = 0;
    enemyActionTimer = 0;
    releaseCooldown = 0;
}

function loop() {
    if (gameStarted) {
        drawField3D();
        
        ctx.beginPath();
        ctx.ellipse(ball.x, ball.y + 4, ball.radius * 0.9, ball.radius * 0.45, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
        ctx.fill();
        ctx.closePath();

        ctx.beginPath();
        ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
        let ballGrad = ctx.createRadialGradient(ball.x - 3, ball.y - 3, 2, ball.x, ball.y, ball.radius);
        ballGrad.addColorStop(0, '#ffffff');
        ballGrad.addColorStop(1, '#9e9e9e');
        ctx.fillStyle = ballGrad;
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = '#333';
        ctx.stroke();
        ctx.closePath();

        let sortedPlayers = [...players].sort((a, b) => a.y - b.y);
        sortedPlayers.forEach(player => player.draw());

        updateGame();
    }
    requestAnimationFrame(loop);
}

loop();
</script>

